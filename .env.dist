# Copy this file to .env and fill in the values.
# Never commit .env — it contains the bot token and the LLM API key.

# ---------------------------------------------------------------------------
# Telegram
# ---------------------------------------------------------------------------
# Token from @BotFather (required). Format: 123456789:AA...
BOT_TOKEN=

# Comma-separated numeric Telegram user IDs for startup notifications and /health.
# Get your ID from @userinfobot. Leave empty to disable admin-only features.
ADMINS=

# ---------------------------------------------------------------------------
# Data / DuckDB
# ---------------------------------------------------------------------------
# Build the file first: python utils/db_api/load_data.py
DB_PATH=data/uzex.duckdb

# Hard limits for every LLM-generated SQL query.
SQL_TIMEOUT_SECONDS=15
SQL_MAX_ROWS=100

# ---------------------------------------------------------------------------
# LLM — Anthropic Claude Haiku 5.5 via its OpenAI-compatible endpoint
# ---------------------------------------------------------------------------
# The client appends /chat/completions to this base URL (no trailing slash).
LLM_BASE_URL=https://api.anthropic.com/v1
# Anthropic API key from the Claude Console (starts with sk-ant-...).
LLM_API_KEY=
LLM_MODEL=claude-haiku-5-5

# Optional provider reasoning effort. Anthropic Haiku 5.5 does not use this;
# leave empty. Gemini 3.x uses low | medium | high.
LLM_REASONING_EFFORT=

# To use another OpenAI-compatible provider, replace the three lines above:
#   Gemini:     LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#               LLM_MODEL=gemini-3.8-flash
#               LLM_REASONING_EFFORT=low
#   OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1
#               LLM_MODEL=anthropic/claude-haiku-5.5
#               LLM_REASONING_EFFORT=
#   OpenAI:     LLM_BASE_URL=https://api.openai.com/v1
#               LLM_MODEL=gpt-4o-mini
#               LLM_REASONING_EFFORT=
#   DeepSeek:   LLM_BASE_URL=https://api.deepseek.com/v1
#               LLM_MODEL=deepseek-chat
#               LLM_REASONING_EFFORT=
#   Ollama:     LLM_BASE_URL=http://localhost:11434/v1
#               LLM_MODEL=qwen2.5:14b
#               LLM_REASONING_EFFORT=

# Anthropic 5.5 models reject temperature; the client omits it automatically.
# Other providers use LLM_TEMPERATURE (0 keeps answers deterministic).
# Model behaviour
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=4096
# Reserved finalization can cover long multi-part answers and internal evidence bindings.
LLM_FINAL_MAX_TOKENS=8192
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_MAX_TOOL_ROUNDS=6

# Optional headers as JSON. OpenRouter example:
# {"HTTP-Referer":"https://github.com/ikramovmuhammadziyo/uzex-spot-hackaton","X-Title":"UZEX Spot Bot"}
LLM_EXTRA_HEADERS=

# ---------------------------------------------------------------------------
# Bot behaviour
# ---------------------------------------------------------------------------
AGENT_TIMEOUT_SECONDS=75
MAX_QUESTION_CHARS=2000
MAX_HISTORY_TURNS=8
HISTORY_TTL_SECONDS=1800
RATE_LIMIT_SECONDS=1.5

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_DIR=logs
QA_LOG_PATH=logs/qa.jsonl

# Successful deterministic tool results only; 0 entries disables caching.
TOOL_CACHE_ENTRIES=256
TOOL_CACHE_BYTES=8388608
