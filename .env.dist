# Copy this file to .env and fill in the values.
# Never commit .env — it contains the bot token and the LLM API key.

# Telegram bot token from @BotFather (required)
BOT_TOKEN=123456789:replace-me

# Comma-separated Telegram user IDs that receive startup/health notifications.
# Leave empty to disable admin notifications.
ADMINS=

# Path to the DuckDB file built by utils/db_api/load_data.py
DB_PATH=data/uzex.duckdb

# Any OpenAI-compatible API. Examples:
#   OpenAI:     https://api.openai.com/v1
#   OpenRouter: https://openrouter.ai/api/v1
#   DeepSeek:   https://api.deepseek.com/v1
#   Ollama:     http://localhost:11434/v1
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Model behaviour
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=1600
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_MAX_TOOL_ROUNDS=6

# Optional headers as JSON, e.g. {"HTTP-Referer":"https://example.com"}
LLM_EXTRA_HEADERS=

# Bot behaviour
AGENT_TIMEOUT_SECONDS=75
MAX_QUESTION_CHARS=2000
MAX_HISTORY_TURNS=8
HISTORY_TTL_SECONDS=1800
RATE_LIMIT_SECONDS=1.5

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs
QA_LOG_PATH=logs/qa.jsonl
